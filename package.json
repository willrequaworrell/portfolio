{
  "name": "will-worrell-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile:portfolio": "node --import tsx scripts/compile-portfolio-material.ts",
    "prebuild": "npm run compile:portfolio",
    "predev": "npm run compile:portfolio",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "npm run compile:portfolio && tsc --noEmit",
    "test": "npm run test:unit && npm run test:browser",
    "test:browser": "PORTFOLIO_ASSISTANT_ENABLED=false npm run build && ASSISTANT_EXPECT_DISABLED=true PORTFOLIO_ASSISTANT_ENABLED=false playwright test && PORTFOLIO_ASSISTANT_ENABLED=true PORTFOLIO_ASSISTANT_MODEL_ID=fake/portfolio-assistant npm run build && ASSISTANT_EXPECT_ENABLED=true PORTFOLIO_ASSISTANT_ENABLED=true PORTFOLIO_ASSISTANT_MODEL_ID=fake/portfolio-assistant playwright test tests/acceptance/assistant.spec.ts",
    "test:unit": "vitest run",
    "test:update": "npm run build && playwright test --update-snapshots=all"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.80",
    "@ai-sdk/provider": "^4.0.14",
    "@ai-sdk/react": "^4.0.102",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/league-gothic": "^5.3.0",
    "ai": "^7.0.99",
    "gray-matter": "^4.0.3",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
